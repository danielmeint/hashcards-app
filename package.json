{
  "name": "hashcards-app",
  "version": "1.0.0",
  "description": "Spaced-repetition flashcards in Markdown, in your own GitHub repo: the app and the hc CLI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p cli",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p cli",
    "e2e": "playwright test",
    "screenshots": "playwright test -c scripts/screenshots/playwright.config.ts",
    "deploy:dev": "vite build && npx wrangler pages deploy dist --project-name hashcards-app --branch dev",
    "build:cli": "vite build -c vite.cli.config.ts"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "hc": "dist-cli/hc.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lit-html": "^3.3.3",
    "marked": "^17.0.4",
    "ts-fsrs": "5.4.2"
  }
}
