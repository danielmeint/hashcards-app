{
  "name": "hashcards-app",
  "version": "1.0.0",
  "description": "PWA for spaced repetition flashcards from GitHub",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e",
    "e2e": "playwright test",
    "deploy:dev": "vite build && npx wrangler pages deploy dist --project-name hashcards-app --branch dev"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lit-html": "^3.3.3",
    "marked": "^17.0.4",
    "ts-fsrs": "5.4.2"
  }
}
